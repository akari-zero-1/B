# ==============================================================================
# APP CONFIGURATION
# ==============================================================================
APP_NAME="ShopAI Agent Backend"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# CORS Origins (Allow Frontend G on port 3000)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000", "http://localhost:5173"]

# ==============================================================================
# LLM PROVIDERS: GROQ & OPENROUTER (Thay vì giả định OpenAI)
# ==============================================================================
# Chọn provider mặc định: "groq" hoặc "openrouter"
LLM_PROVIDER="groq"

# 1. Cấu hình Groq API (Siêu nhanh, miễn phí/giá rẻ)
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# 2. Cấu hình OpenRouter API (Hỗ trợ DeepSeek, Claude, Llama, v.v.)
OPENROUTER_API_KEY="sk-or-v1-your_openrouter_api_key_here"
OPENROUTER_MODEL="deepseek/deepseek-chat"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ==============================================================================
# LANGSMITH TRACING (3 Environment Variables bắt buộc để bật tracing)
# ==============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY="lsv2_pt_your_langsmith_api_key_here"
LANGCHAIN_PROJECT="shopai-agent"
# Tùy chọn endpoint:
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"

# ==============================================================================
# DATABASE & STORAGE
# ==============================================================================
DATABASE_URL="sqlite+aiosqlite:///./shopai.db"
REDIS_URL="redis://localhost:6379/0"
